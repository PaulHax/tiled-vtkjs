{
  "name": "tiled-vtkjs",
  "version": "0.0.0-development",
  "description": "Adaptive level of detail for large 3D datasets in vtk.js",
  "keywords": [
    "3d-tiles",
    "copc",
    "level-of-detail",
    "lod",
    "octree",
    "point-cloud",
    "streaming",
    "tiling",
    "vtk",
    "vtk.js",
    "webgl"
  ],
  "homepage": "https://github.com/PaulHax/tiled-vtkjs#readme",
  "bugs": {
    "url": "https://github.com/PaulHax/tiled-vtkjs/issues"
  },
  "license": "MIT",
  "author": "Paul Elliott",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulHax/tiled-vtkjs.git"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "!src/**/*.test.ts",
    "test/fixtures/tiles3d-source-contract.json",
    "vtkjs-fork.env"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./points": {
      "types": "./dist/points/index.d.ts",
      "import": "./dist/points.js"
    },
    "./points/vtk": {
      "types": "./dist/points/vtk.d.ts",
      "import": "./dist/points-vtk.js"
    },
    "./points/copc-worker": {
      "types": "./dist/points/copcWorker.d.ts",
      "import": "./dist/copcWorker.js"
    },
    "./tiles3d": {
      "types": "./dist/tiles3d/index.d.ts",
      "import": "./dist/tiles3d.js"
    },
    "./tiles3d/vtk": {
      "types": "./dist/tiles3d/vtk.d.ts",
      "import": "./dist/tiles3d-vtk.js"
    },
    "./tiles3d/decode-worker": {
      "default": "./dist/tiles3dDecodeWorker.classic.js"
    },
    "./tiles3d/gaussian-sort-worker": {
      "default": "./dist/gaussianSortWorker.js"
    },
    "./tiles3d/codecs/*": {
      "default": "./dist/tiles3d-codecs/*"
    }
  },
  "scripts": {
    "test": "vitest run",
    "commitlint": "commitlint",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p examples/vtk/tsconfig.json",
    "build": "vite build && vite build --config vite.tiles3d-worker.config.ts && tsc -p tsconfig.build.json",
    "example": "vite --config examples/vtk/vite.config.ts",
    "example:build": "vite build --config examples/vtk/vite.config.ts",
    "test:browser": "npm run build && npm run example:build && vitest run --config vitest.browser.config.ts",
    "test:perf": "npm run example:build && vitest run --config vitest.perf.config.ts",
    "telemetry:capture": "TILED_VTKJS_BROWSER_GPU=1 npm run test:perf -- test/browser/telemetry-capture.perf.spec.ts",
    "bench:replay": "npm run build && npm run example:build && TILED_VTKJS_BROWSER_GPU=1 vitest run --config vitest.perf.config.ts test/browser/replay.perf.spec.ts",
    "bench:analyze": "node scripts/analyzeReplay.mjs",
    "trace:analyze": "node scripts/analyzeTrace.mjs",
    "fixture:tiles3d": "node scripts/generateTiles3dFixture.mjs",
    "fixture:meshopt": "node scripts/generateMeshoptFixtures.mjs",
    "verify:chain": "node scripts/verifyChain.mjs",
    "prepare": "npm run build && node .husky/install.mjs",
    "verify:boundaries": "node scripts/checkBoundaries.mjs",
    "verify:package": "node scripts/verifyPackage.mjs"
  },
  "dependencies": {
    "@adobe/spz": "0.2.3",
    "@loaders.gl/core": "4.4.4",
    "@loaders.gl/draco": "4.4.4",
    "@loaders.gl/gltf": "4.4.4",
    "@loaders.gl/textures": "4.4.4",
    "@loaders.gl/worker-utils": "4.4.4",
    "@types/emscripten": "1.41.6",
    "copc": "^0.0.8",
    "ktx-parse": "0.7.1",
    "laz-perf": "^0.0.7"
  },
  "devDependencies": {
    "3d-tiles-validator": "^0.6.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.0",
    "@types/node": "^26.1.1",
    "cesium": "^1.144.0",
    "draco3dgltf": "^1.5.7",
    "gltf-validator": "^2.0.0-dev.3.10",
    "husky": "^9.1.7",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^0.19.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.0",
    "semantic-release": "^25.0.0",
    "sharp": "^0.34.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
